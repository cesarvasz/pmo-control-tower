# ─────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno. Copia este archivo a .env.local y
# rellena los valores. NUNCA subas .env.local a git (contiene secretos).
# ─────────────────────────────────────────────────────────────────────

# ── Monday.com — PRIVADA, solo servidor (sin prefijo NEXT_PUBLIC_) ─────
MONDAY_API_KEY=

# ── Google Calendar WebApp (Apps Script) ──────────────────────────────
CALENDAR_WEBAPP_URL=

# ── WebApp del Apps Script de recordatorios "Sin Valor Def" (opcional) ──
# doGet que devuelve el registro de correos enviados; alimenta la tabla "En Espera".
# Si se deja vacío, la tabla muestra 0 enviados. Ver apps-script/README.md.
REMINDERS_WEBAPP_URL=

# ── IDs de Monday (no son secretos) ───────────────────────────────────
MONDAY_INI_BOARD_ID=18412996100
MONDAY_REQ_BOARD_ID=18413204916
MONDAY_PROJ_FOLDER_ID=18108861
MONDAY_RH_BOARD_ID=
# Board "Estrategia 🔝" (U Neg / País). Opcional: si se omite usa el default.
MONDAY_EST_BOARD_ID=18291587533

# ── Firebase Web — PÚBLICA (va al cliente por diseño) ─────────────────
# Firebase Console → Project Settings → Your apps (Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Restricción de dominio de login (cliente + servidor) ──────────────
NEXT_PUBLIC_ALLOWED_DOMAIN=c807.com

# ── Firebase Admin SDK (SOLO servidor) · Service Account ──────────────
# Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_ADMIN_CLIENT_EMAIL=
# La private_key entre comillas dobles y con los \n literales (no saltos reales).
FIREBASE_ADMIN_PRIVATE_KEY=""
