# ─────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno. Copia este archivo a .env.local y
# rellena los valores. NUNCA subas .env.local a git (contiene secretos).
# ─────────────────────────────────────────────────────────────────────

# ── Monday.com — PRIVADA, solo servidor (sin prefijo NEXT_PUBLIC_) ─────
MONDAY_API_KEY=

# ── Google Calendar WebApp (Apps Script) ──────────────────────────────
CALENDAR_WEBAPP_URL=

# ── WebApp del Apps Script de recordatorios "Sin Valor Def" (opcional) ──
# doGet que devuelve el registro de correos enviados; alimenta la tabla "En Espera".
# Si se deja vacío, la tabla muestra 0 enviados. Ver apps-script/README.md.
REMINDERS_WEBAPP_URL=

# ── WebApp del Apps Script de la bitácora ROI (Google Sheets, pestaña "003") ──
# doGet que expone la hoja; alimenta la pestaña "003" de la página "ROI".
# Fuente independiente del resto del dashboard. Ver apps-script/roi-log-README.md.
ROI_WEBAPP_URL=

# ── WebApp del Apps Script de Clonación de Files (Google Sheets, pestaña "Clonación") ──
# doGet que expone la hoja; alimenta la pestaña "Clonación de Files" de la
# página "ROI". Fuente independiente de 003. Ver apps-script/roi-clonacion-README.md.
ROI_CLONACION_WEBAPP_URL=

# ── WebApp del Apps Script de Implementación (Google Sheets, pestaña "implementacion") ──
# Mismo archivo que Clonación, otra pestaña. doGet que expone la hoja; alimenta la
# pestaña "Implementación" de la página "ROI". Fuente independiente. Ver
# apps-script/roi-implementacion-README.md.
ROI_IMPLEMENTACION_WEBAPP_URL=

# ── WebApp del Apps Script de ROI 008 (Google Sheets, hoja ROI, pestaña "008") ──
# Misma hoja que 003, otra pestaña, su propio Apps Script. Alimenta la pestaña
# "Ducafast SV" (análisis de tiempos) de la página "ROI". Ver apps-script/roi-008-README.md.
ROI_008_WEBAPP_URL=

# ── IDs de Monday (no son secretos) ───────────────────────────────────
MONDAY_INI_BOARD_ID=18412996100
MONDAY_REQ_BOARD_ID=18413204916
MONDAY_PROJ_FOLDER_ID=18108861
MONDAY_RH_BOARD_ID=
# Board "Estrategia 🔝" (U Neg / País). Opcional: si se omite usa el default.
MONDAY_EST_BOARD_ID=18291587533
# De dónde lee la app Iniciativas, PML, Proyectos, Estrategia y el Directorio RH (Tableros propios,
# Fase 6): "monday" (default) = la API de Monday; "tableros" = los tableros de Supabase, que la
# sincronización de cada hora mantiene al día. Lo que la app escribe (status) sigue yendo a Monday.
FUENTE_DATOS=monday

# ── Supabase ──────────────────────────────────────────────────────────
# Supabase → Project Settings → API Keys. La URL y la publishable key son
# públicas (van al cliente para el login). La SECRET key es SOLO servidor:
# es la única que puede leer/escribir las tablas (RLS sin políticas).
# En Vercel las dos públicas se pueden llamar SUPABASE_URL y SUPABASE_PUBLISHABLE_KEY
# (sin prefijo, para poder marcarlas Sensitive): next.config.ts las incrusta igual.
NEXT_PUBLIC_SUPABASE_URL=https://kfefgddnshggjbanyblu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ── Restricción de dominio de login (cliente + servidor) ──────────────
NEXT_PUBLIC_ALLOWED_DOMAIN=c807.com

# Google Calendar por usuario (agendar Meeting 1 / Meeting 2 de Iniciativas). Ver docs/google-calendar.md
# Cliente OAuth «Aplicación web» creado en Google Cloud (pantalla de consentimiento Interna). Redirect URIs:
#   http://localhost:3000/api/google/callback  y  https://pmo-control-tower.vercel.app/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Firma del «state» del OAuth: cadena aleatoria de 32+ caracteres (p. ej. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
GOOGLE_STATE_SECRET=
# Llave del Apps Script de recordatorios «Sin Valor Def» para leer las iniciativas de la app (GET /api/iniciativas/recordatorios,
# "Authorization: Bearer <valor>"). El mismo valor va en la Script Property APP_SECRET. Sin ella, ese endpoint responde 503.
RECORDATORIOS_SECRET=
# Muestra el botón «📅 Agendar» en las iniciativas de /tableros (1 = encendido; sin la variable = apagado). Pública: se lee al arrancar.
NEXT_PUBLIC_AGENDAR_REUNIONES=

# Bot de Google Chat «Nueva iniciativa» (app de Chat como Google Workspace add-on, endpoint HTTP). Ver docs/google-chat.md
# URL EXACTA configurada en Google Cloud → Chat API → Configuración (es la audiencia del token y la de los botones), p. ej.
#   https://pmo-control-tower.vercel.app/api/google-chat   (en local: la URL del túnel + /api/google-chat)
GOOGLE_CHAT_URL=
# «Service account email» que muestra esa misma página: service-NUMERO@gcp-sa-gsuiteaddons.iam.gserviceaccount.com
# Sin estas dos variables el bot está apagado (el endpoint responde 503).
GOOGLE_CHAT_CUENTA_SERVICIO=
# 1 = escribe en la consola del servidor la forma de cada evento (sin tokens), para la primera prueba con Google real.
GOOGLE_CHAT_DIAGNOSTICO=
# Llave JSON (completa, o en base64) de la cuenta de servicio del bot, scope chat.bot: para bajar los archivos que le mandan
# en el chat y avisar cuando terminó de adjuntarlos. Sin ella, el bot dice que todavía no puede recibir archivos. SECRETA.
GOOGLE_CHAT_LLAVE=
